# =============================================================================
# apps/mobile — environment
# =============================================================================
# Variables prefixed with EXPO_PUBLIC_ are inlined into the JS bundle and are
# therefore PUBLIC. Never put secrets here.
# =============================================================================

# API base URL.
#   Simulator/web:        http://localhost:3000
#   iOS device:           http://<your-mac's-LAN-ip>:3000
#   Android device:       http://<your-machine's-LAN-ip>:3000
#   Tailscale (later):    https://plant-app.<your-tailnet>.ts.net
EXPO_PUBLIC_API_URL=http://localhost:3000
