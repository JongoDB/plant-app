# =============================================================================
# apps/api — environment
# =============================================================================
# Copy to .env and fill in. Never commit .env.
# =============================================================================

# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database ---
# Match docker-compose.yml defaults during local dev.
DATABASE_URL=postgres://plant:plant_dev_password@localhost:5432/plant_app

# --- Auth (Better Auth — wired in Slice 1) ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=change_me_in_dev_too
AUTH_BASE_URL=http://localhost:3000

# OAuth providers — leave blank to disable a provider.
# Slice 1 wires these up; values can stay blank for Slice 0.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email (Resend, free tier — wired in Slice 1) ---
RESEND_API_KEY=
EMAIL_FROM="Plant App <hello@example.com>"

# --- LLM (Anthropic, wired in Slice 3) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- External APIs (wired in later slices) ---
PLANTNET_API_KEY=
# Open-Meteo needs no key.

# --- Storage ---
# Where on-disk objects live. Stays out of git.
STORAGE_DIR=./data/storage
# Public base URL the mobile app uses to download stored objects.
# In dev this is the API itself serving static.
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/storage

# --- AI worker (future MacBook deploy) ---
# When set, STT/TTS/vision can route to a native worker on the host.
# Leave blank in Slice 0; gets wired in once the worker exists.
# AI_WORKER_URL=http://127.0.0.1:8081

# --- Push notifications (wired in later slice) ---
# APNs (HTTP/2 + JWT)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY_PATH=
APNS_PRODUCTION=false
# FCM (HTTP v1)
FCM_SERVICE_ACCOUNT_JSON_PATH=
