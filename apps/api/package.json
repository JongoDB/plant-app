{
  "name": "@plant-app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env --clear-screen=false src/index.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo '(lint not configured)'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@better-auth/expo": "^1.6.10",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@plant-app/shared": "workspace:*",
    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.1.0",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
