{
  "name": "plant-app",
  "private": true,
  "version": "0.0.0",
  "description": "Plant care app with local-first AI assistant (Rooti). Mobile (React Native + Expo) and self-hosted API (Fastify + Postgres).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:api": "pnpm --filter @plant-app/api dev",
    "dev:mobile": "pnpm --filter @plant-app/mobile dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
