# =============================================================================
# plant-app — root .env.example
# =============================================================================
# Each app has its own .env (apps/api/.env, apps/mobile/.env). This file
# documents shared variables that affect Docker Compose and dev scripts.
#
# Copy to .env and fill in real values:
#   cp .env.example .env
# =============================================================================

# Local data dir (Postgres volume, uploads, etc.). Stays out of git.
DATA_DIR=./data

# Postgres (Docker Compose)
POSTGRES_USER=plant
POSTGRES_PASSWORD=plant_dev_password
POSTGRES_DB=plant_app
POSTGRES_PORT=5432

# Reserved for future MacBook deployment with Caddy + Tailscale.
# Uncomment when porting; see docker-compose.yml caddy slot.
# PUBLIC_HOSTNAME=plant-app.your-tailnet.ts.net
